{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SmartDesk",
    "Audience": "SmartDesk",
    "AccessTokenLifetimeMinutes": 60
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 10
  }
}
